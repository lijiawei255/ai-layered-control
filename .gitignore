# ---------------------------------------------------------------------------
# ai-layered-control -- repository hygiene
# ---------------------------------------------------------------------------
# This repository is a *reference architecture*: the tracked content is plain
# text plus three PNG figures and one .slx model.  Everything a build, an IDE
# or a local AI agent produces must stay out of Git.
# ---------------------------------------------------------------------------

# --- Python (tooling only) -------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
ENV/
# Python benchmark: generated shared library, build cache and output figure
python_bench/build/
python_bench/*.png
python_bench/*.so
python_bench/*.dll
python_bench/*.dylib

# --- MATLAB / Simulink temporary and build artefacts -----------------------
slprj/
*.slxc
*.slx.r*
*.mdl.r*
*.autosave
*.slx.autosave
*.mdl.autosave
*.asv
*.mex*
*.mat
*.fig
*.mlp
*.m~
codegen/
build/
# Simulink crash recovery / editor backups
*.slx~
*.mdl~
*.bak

# --- C / native build artefacts -------------------------------------------
*.exe
*.out
*.o
*.obj
*.dll
*.so
*.dylib
*.lib
*.exp
*.pdb
*.ilk
*.stackdump
*.dSYM/
a.out

# --- Cross-platform test / equivalence / scratch artefacts ----------------
c99_layered_core/test_gatekeeper_standalone
c99_layered_core/verify_core_equivalence
c99_layered_core/*.bin
c99_layered_core/*.csv
matlab_simulink/*.bin
matlab_simulink/*.csv

# --- Local IDE / AI-agent / OS files ---------------------------------------
.vscode/
.idea/
.cursor/
.deepseek/
.claude/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# --- Intermediates produced while rebuilding the Simulink package ----------
*.slx.zip
*.zip.tmp

# --- Local scratch space used while iterating on the benchmark -------------
_scratch/

# --- Deliverables that must NEVER be swallowed by a broad ignore pattern ---
# The generated Simulink benchmark and the publication figures are the
# artefacts this repository exists to ship.
!matlab_simulink/*.slx
!assets/*.png
